<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.insurancebilling</groupId>
    <artifactId>insurance-billing-qa-framework</artifactId>
    <version>1.2.0</version>
  </parent>

  <artifactId>qa-bdd-tests</artifactId>
  <name>QA BDD Tests</name>
  <description>
    Cucumber feature files and step definitions. This module contains scenarios and glue code only:
    all automation logic is reused from the API and UI modules.
  </description>

  <properties>
    <!--
      Everything in this module is test code, including what lives in src/main/java. Those classes are
      the framework the tests are written against - clients, page objects, specifications - not product
      code that ships.

      Saying so matters for two reasons. Sonar applies a different, more appropriate rule set to test
      code. And a file Sonar treats as product code with no coverage data behind it counts as 0%
      covered, so leaving the default would drag the project's coverage figure down with framework
      classes that nothing measures and nothing was ever going to.
    -->
    <sonar.sources></sonar.sources>
    <sonar.tests>src/test/java</sonar.tests>

    <ui.headless>true</ui.headless>
    <cucumber.filter.tags>not @wip</cucumber.filter.tags>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-java</artifactId>
    </dependency>
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-testng</artifactId>
    </dependency>
    <!--
      Provides the dependency injection that gives each scenario a fresh ScenarioContext. Without an
      object factory, shared state would have to live in static fields, which is the usual way a BDD
      suite becomes order-dependent and impossible to parallelise.
    -->
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-picocontainer</artifactId>
      <version>${cucumber.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.insurancebilling</groupId>
      <artifactId>qa-api-tests</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.insurancebilling</groupId>
      <artifactId>qa-ui-tests</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.testng</groupId>
      <artifactId>testng</artifactId>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>${slf4j.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <systemPropertyVariables>
            <app.base.url>${app.base.url}</app.base.url>
            <ui.headless>${ui.headless}</ui.headless>
            <ui.screenshot.dir>${project.build.directory}/screenshots</ui.screenshot.dir>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
