<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.insurancebilling</groupId>
  <artifactId>insurance-billing-qa-framework</artifactId>
  <version>1.2.0</version>
  <packaging>pom</packaging>

  <name>Insurance Billing QA Framework</name>
  <description>
    Simulated insurance billing platform and its end-to-end QA automation framework.
  </description>

  <modules>
    <module>billing-app</module>
    <module>qa-api-tests</module>
    <module>qa-ui-tests</module>
    <module>qa-bdd-tests</module>
  </modules>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <spring.boot.version>3.5.16</spring.boot.version>
    <selenium.version>4.49.0</selenium.version>
    <rest.assured.version>5.5.7</rest.assured.version>
    <testng.version>7.12.0</testng.version>
    <cucumber.version>7.34.8</cucumber.version>
    <anthropic.sdk.version>2.63.0</anthropic.sdk.version>
    <mcp.sdk.version>2.0.1</mcp.sdk.version>
    <assertj.version>3.27.7</assertj.version>
    <slf4j.version>2.0.17</slf4j.version>

    <exec.plugin.version>3.6.3</exec.plugin.version>
    <surefire.version>3.6.0</surefire.version>
    <jacoco.version>0.8.15</jacoco.version>
    <failsafe.version>3.6.0</failsafe.version>
    <sonar.plugin.version>5.8.0.7211</sonar.plugin.version>

    <!-- Default target for every suite that drives the running application. -->
    <app.base.url>http://localhost:8080</app.base.url>

    <!--
      SonarQube Cloud analysis. Configured here rather than in a sonar-project.properties file: the
      Maven scanner takes its configuration from the POM and ignores that file in a multi-module
      build, so a properties file would look authoritative while doing nothing.

      The analysis itself runs only in CI, where SONAR_TOKEN exists. See docs/code-quality.md.
    -->
    <sonar.host.url>https://sonarcloud.io</sonar.host.url>
    <sonar.organization>abdeljalilsennaoui</sonar.organization>
    <sonar.projectKey>abdeljalilsennaoui_insurance-billing-qa-framework</sonar.projectKey>
    <!--
      Both reports are listed, and only one of them exists at a time.

      An ordinary build produces the in-process report, which is what CI has. scripts/coverage.sh
      additionally produces the full-stack report, which includes everything the API, UI and BDD
      suites exercise in the application's own JVM - the difference is 91% line coverage against 99%,
      and docs/coverage.md explains why. Listing both means a local analysis after coverage.sh sends
      the fuller picture without needing different arguments; the scanner warns about the path that
      is absent and carries on.
    -->
    <sonar.coverage.jacoco.xmlReportPaths>${maven.multiModuleProjectDirectory}/billing-app/target/site/jacoco/jacoco.xml,${maven.multiModuleProjectDirectory}/billing-app/target/site/jacoco-full/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring.boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.seleniumhq.selenium</groupId>
        <artifactId>selenium-java</artifactId>
        <version>${selenium.version}</version>
      </dependency>
      <dependency>
        <groupId>io.rest-assured</groupId>
        <artifactId>rest-assured</artifactId>
        <version>${rest.assured.version}</version>
      </dependency>
      <dependency>
        <groupId>io.rest-assured</groupId>
        <artifactId>json-schema-validator</artifactId>
        <version>${rest.assured.version}</version>
      </dependency>
      <dependency>
        <groupId>org.testng</groupId>
        <artifactId>testng</artifactId>
        <version>${testng.version}</version>
      </dependency>
      <dependency>
        <groupId>io.cucumber</groupId>
        <artifactId>cucumber-java</artifactId>
        <version>${cucumber.version}</version>
      </dependency>
      <dependency>
        <groupId>io.cucumber</groupId>
        <artifactId>cucumber-testng</artifactId>
        <version>${cucumber.version}</version>
      </dependency>
      <dependency>
        <groupId>org.assertj</groupId>
        <artifactId>assertj-core</artifactId>
        <version>${assertj.version}</version>
      </dependency>
      <!--
        The vendor's own SDK rather than an abstraction over several providers. Spring AI is the
        framework-idiomatic choice and was rejected for a concrete reason, recorded in
        docs/design-rationale.md: spring-ai-starter-mcp-server-webmvc 2.0.1 declares
        spring-boot-starter-web 4.1.1, so adopting it would drag this application from Spring Boot 3.5
        to 4.1. This dependency is a plain library with no opinion about the framework around it.
      -->
      <dependency>
        <groupId>com.anthropic</groupId>
        <artifactId>anthropic-java</artifactId>
        <version>${anthropic.sdk.version}</version>
      </dependency>
      <!--
        The MCP server, as mcp-core plus the Jackson 2 binding rather than the aggregate mcp artifact.
        mcp pulls mcp-json-jackson3, and this application is a Spring Boot 3.5 application on Jackson
        2: two Jackson majors on one classpath to serialise the same four DTOs is a cost with nothing
        bought. mcp-json-jackson2 also lets the MCP surface share the application's own ObjectMapper,
        which is what makes its JSON identical to the REST API's rather than merely similar.
      -->
      <dependency>
        <groupId>io.modelcontextprotocol.sdk</groupId>
        <artifactId>mcp-core</artifactId>
        <version>${mcp.sdk.version}</version>
      </dependency>
      <dependency>
        <groupId>io.modelcontextprotocol.sdk</groupId>
        <artifactId>mcp-json-jackson2</artifactId>
        <version>${mcp.sdk.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <!--
            Retains method parameter names in the bytecode. Spring binds @PathVariable and
            @RequestParam by parameter name, and without this flag the names are erased at compile
            time and every annotated handler argument fails at runtime. The Spring Boot starter
            parent sets this by default; this project imports the Boot BOM instead of inheriting
            from that parent, so the flag has to be set here.
          -->
          <parameters>true</parameters>
        </configuration>
      </plugin>
    </plugins>

    <pluginManagement>
      <plugins>
        <!--
          Pinned rather than invoked as the unversioned 'sonar:sonar' prefix, which resolves to
          whatever the latest release is on the day the job runs. A scanner that upgrades itself
          without a commit can change an analysis result with nothing in the history to explain it.
        -->
        <plugin>
          <groupId>org.sonarsource.scanner.maven</groupId>
          <artifactId>sonar-maven-plugin</artifactId>
          <version>${sonar.plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${surefire.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>${failsafe.version}</version>
        </plugin>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring.boot.version}</version>
        </plugin>
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${jacoco.version}</version>
        </plugin>
        <!--
          Runs the documentation screenshot tool in qa-ui-tests. Pinned here rather than left to
          Maven's latest-release resolution, which would make a build's behaviour depend on the day
          it ran.
        -->
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>exec-maven-plugin</artifactId>
          <version>${exec.plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
