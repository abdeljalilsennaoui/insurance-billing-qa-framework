<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.insurancebilling</groupId>
    <artifactId>insurance-billing-qa-framework</artifactId>
    <version>1.0.0</version>
  </parent>

  <artifactId>qa-ui-tests</artifactId>
  <name>QA UI Tests</name>
  <description>
    Selenium 4 UI automation. Driver management and page objects live in src/main/java so the BDD
    module can reuse them; the UI test classes live in src/test/java.
  </description>

  <properties>
    <ui.headless>true</ui.headless>
    <ui.screenshot.dir>${project.build.directory}/screenshots</ui.screenshot.dir>
    <!-- Which TestNG groups to run: ui-smoke, ui-negative or ui-regression. -->
    <ui.groups>ui-regression</ui.groups>
    <!--
      Where the documentation screenshots are written. Under docs/ rather than target/ because these
      images are committed and referenced by docs/test-report.md, unlike the failure screenshots the
      suite produces, which are build output.
    -->
    <docs.screenshot.dir>${project.basedir}/../docs/screenshots</docs.screenshot.dir>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.seleniumhq.selenium</groupId>
      <artifactId>selenium-java</artifactId>
    </dependency>
    <!-- The UI suite provisions its own test data through the API clients. -->
    <dependency>
      <groupId>com.insurancebilling</groupId>
      <artifactId>qa-api-tests</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.testng</groupId>
      <artifactId>testng</artifactId>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>${slf4j.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        Runs the documentation screenshot tool:

          mvn -q -pl qa-ui-tests exec:java -Dexec.args=console
          mvn -q -pl qa-ui-tests exec:java -Dexec.args=reports

        Bound to no phase and never part of a build. Capturing screenshots needs a running
        application and takes a browser session per page, and neither belongs in the path between a
        developer and a compiled artifact.
      -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <configuration>
          <mainClass>com.insurancebilling.qa.ui.docs.DocumentationScreenshots</mainClass>
          <systemProperties>
            <systemProperty>
              <key>app.base.url</key>
              <value>${app.base.url}</value>
            </systemProperty>
            <systemProperty>
              <key>ui.headless</key>
              <value>${ui.headless}</value>
            </systemProperty>
            <systemProperty>
              <key>docs.screenshot.dir</key>
              <value>${docs.screenshot.dir}</value>
            </systemProperty>
            <!--
              exec:java runs in the Maven JVM, so relative paths resolve against the directory Maven
              was started in. The module's own location is the only thing that reliably identifies
              the repository root.
            -->
            <systemProperty>
              <key>docs.repo.root</key>
              <value>${project.basedir}/..</value>
            </systemProperty>
          </systemProperties>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <!--
            Group selection goes through Failsafe's own parameter; suiteXmlFiles is unsupported from
            3.6.0 onwards and is silently ignored.
          -->
          <groups>${ui.groups}</groups>
          <systemPropertyVariables>
            <app.base.url>${app.base.url}</app.base.url>
            <ui.headless>${ui.headless}</ui.headless>
            <ui.screenshot.dir>${ui.screenshot.dir}</ui.screenshot.dir>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
