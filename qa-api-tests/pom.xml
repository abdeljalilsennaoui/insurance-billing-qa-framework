<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.insurancebilling</groupId>
    <artifactId>insurance-billing-qa-framework</artifactId>
    <version>1.2.0</version>
  </parent>

  <artifactId>qa-api-tests</artifactId>
  <name>QA API Tests</name>
  <description>
    REST Assured API automation. The reusable framework (clients, specifications, builders) lives in
    src/main/java so that the BDD module can depend on it; the tests themselves live in src/test/java.
  </description>

  <dependencies>
    <dependency>
      <groupId>io.rest-assured</groupId>
      <artifactId>rest-assured</artifactId>
    </dependency>
    <dependency>
      <groupId>io.rest-assured</groupId>
      <artifactId>json-schema-validator</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
    </dependency>
    <dependency>
      <groupId>org.testng</groupId>
      <artifactId>testng</artifactId>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>${slf4j.version}</version>
    </dependency>
  </dependencies>

  <properties>
    <!--
      Everything in this module is test code, including what lives in src/main/java. Those classes are
      the framework the tests are written against - clients, page objects, specifications - not product
      code that ships.

      Saying so matters for two reasons. Sonar applies a different, more appropriate rule set to test
      code. And a file Sonar treats as product code with no coverage data behind it counts as 0%
      covered, so leaving the default would drag the project's coverage figure down with framework
      classes that nothing measures and nothing was ever going to.
    -->
    <sonar.sources></sonar.sources>
    <sonar.tests>src/main/java,src/test/java</sonar.tests>

    <!--
      Which TestNG groups to run. Defaults to the full regression set; override to run a narrower
      slice, for example -Dapi.groups=smoke or -Dapi.groups=negative
    -->
    <api.groups>regression</api.groups>
    <api.threads>4</api.threads>
  </properties>

  <build>
    <plugins>
      <!--
        The API suite drives a running application, so it is an integration suite: Failsafe runs it
        at the verify phase. Surefire finds nothing in this module by design.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <!--
            Group selection is done through Failsafe's own 'groups' parameter rather than a TestNG
            suite XML. maven-failsafe-plugin 3.6.0 dropped support for suiteXmlFiles: it accepts the
            parameter, warns that it is unsupported, and then ignores it, running every *IT class
            instead. That silently turns a 'smoke' run into a full regression run, so the suite XMLs
            were removed rather than left in the repository looking functional.
          -->
          <groups>${api.groups}</groups>
          <parallel>methods</parallel>
          <threadCount>${api.threads}</threadCount>
          <systemPropertyVariables>
            <app.base.url>${app.base.url}</app.base.url>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
