<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.insurancebilling</groupId>
    <artifactId>insurance-billing-qa-framework</artifactId>
    <version>1.2.0</version>
  </parent>

  <artifactId>billing-app</artifactId>
  <name>Billing Application</name>
  <description>Simulated insurance billing platform: the system under test.</description>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-thymeleaf</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!-- SOAP endpoint. Insurance platforms commonly still expose SOAP services to partners. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web-services</artifactId>
    </dependency>
    <dependency>
      <groupId>org.glassfish.jaxb</groupId>
      <artifactId>jaxb-runtime</artifactId>
      <version>${jaxb.runtime.version}</version>
    </dependency>
    <dependency>
      <groupId>wsdl4j</groupId>
      <artifactId>wsdl4j</artifactId>
      <version>${wsdl4j.version}</version>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- The billing assistant's model-backed provider. See com.insurancebilling.assistant. -->
    <dependency>
      <groupId>com.anthropic</groupId>
      <artifactId>anthropic-java</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      A real HTTP server on localhost that the SDK is pointed at with its own baseUrl override, so the
      model-backed provider - the tool loop, the retries, the error mapping - is exercised end to end
      without a key, without the network and without cost. The alternative was mocking the SDK's own
      types, which would have tested that the mock behaves as the mock was told to.
    -->
    <dependency>
      <groupId>com.squareup.okhttp3</groupId>
      <artifactId>mockwebserver</artifactId>
      <version>${mockwebserver.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <properties>
    <!--
      Kept out of the Sonar analysis for the same reason JaCoCo excludes it: xjc writes these classes
      from the XSD into target/generated-sources, Maven adds that directory as a source root, and
      issues raised against generated code are issues with the generator. Nobody can act on them here
      and they would bury the findings that matter.
    -->
    <sonar.exclusions>**/soap/generated/**</sonar.exclusions>
    <jaxb.runtime.version>4.0.9</jaxb.runtime.version>
    <!--
      Pinned to the OkHttp the Anthropic SDK brings (anthropic-java-client-okhttp 2.63.0 -> okhttp
      4.12.0). MockWebServer and OkHttp share internals, so a mismatched pair fails at runtime with a
      NoSuchMethodError rather than at resolution. Spring Boot's BOM manages okhttp but not
      mockwebserver, which is why this is here rather than inherited.
    -->
    <mockwebserver.version>4.12.0</mockwebserver.version>
    <wsdl4j.version>1.6.3</wsdl4j.version>
    <jaxb2.plugin.version>3.2.0</jaxb2.plugin.version>
  </properties>

  <build>
    <finalName>billing-app</finalName>
    <plugins>
      <!--
        Generates the SOAP request and response classes from the XSD at build time.

        Contract-first rather than code-first: the schema is the source of truth and the Java types
        follow from it, so nothing hand-written can drift away from the published contract. Generated
        sources go to target/, never into version control, because a generated file committed next to
        its generator is a second source of truth waiting to disagree.
      -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>jaxb2-maven-plugin</artifactId>
        <version>${jaxb2.plugin.version}</version>
        <executions>
          <execution>
            <id>generate-soap-contract-classes</id>
            <goals>
              <goal>xjc</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <sources>
            <source>src/main/resources/xsd/invoice-status.xsd</source>
          </sources>
          <packageName>com.insurancebilling.soap.generated</packageName>
          <clearOutputDir>false</clearOutputDir>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>

      <!--
        Line and branch coverage for this module's own unit and integration tests.

        prepare-agent instruments the forked Surefire JVM, so this covers the 66 tests that run in
        process. It does NOT cover the API, UI or BDD suites: those drive the application over HTTP in a
        separate JVM, and from the test JVM's perspective nothing in this module was ever called.
        Measuring those needs the agent on the application process instead - see scripts/coverage.sh.
      -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>prepare-unit-coverage</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>unit-coverage-report</id>
            <phase>test</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>

          <!--
            Combines the in-process execution data with the data the agent wrote from the application
            process while the black-box suites ran. Bound to no phase and invoked explicitly by
            scripts/coverage.sh as jacoco:merge@merge-all-coverage, because it only makes sense after the
            application has exited and flushed its data.
          -->
          <execution>
            <id>merge-all-coverage</id>
            <phase>none</phase>
            <goals>
              <goal>merge</goal>
            </goals>
            <configuration>
              <fileSets>
                <fileSet>
                  <directory>${project.build.directory}</directory>
                  <includes>
                    <include>jacoco.exec</include>
                    <!--
                      A pattern rather than the single jacoco-e2e.exec, because CI produces one file
                      per suite job: the API, UI, BDD and smoke suites each drive their own
                      application process on their own runner, and the merge has to take all of them.
                      A local run of scripts/coverage.sh still writes exactly one, and the pattern
                      matches that too.
                    -->
                    <include>jacoco-e2e*.exec</include>
                  </includes>
                </fileSet>
              </fileSets>
              <destFile>${project.build.directory}/jacoco-merged.exec</destFile>
            </configuration>
          </execution>

          <execution>
            <id>full-coverage-report</id>
            <phase>none</phase>
            <goals>
              <goal>report</goal>
            </goals>
            <configuration>
              <dataFile>${project.build.directory}/jacoco-merged.exec</dataFile>
              <outputDirectory>${project.build.directory}/site/jacoco-full</outputDirectory>
            </configuration>
          </execution>
        </executions>
        <configuration>
          <excludes>
            <!--
              Generated from the XSD by xjc. Excluded because coverage of generated code measures the
              generator, not this project's tests, and including it would inflate the figure with
              setters nobody wrote.
            -->
            <exclude>com/insurancebilling/soap/generated/**</exclude>
          </excludes>
        </configuration>
      </plugin>

      <!--
        Copies the JaCoCo agent jar next to the application jar so scripts/start-app.sh can attach it to
        the application process for full-stack coverage. Resolved through Maven rather than downloaded by
        a script, so the agent version cannot drift from the plugin version.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-jacoco-agent</id>
            <phase>package</phase>
            <goals>
              <goal>copy</goal>
            </goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>org.jacoco</groupId>
                  <artifactId>org.jacoco.agent</artifactId>
                  <version>${jacoco.version}</version>
                  <classifier>runtime</classifier>
                  <destFileName>jacoco-agent.jar</destFileName>
                </artifactItem>
              </artifactItems>
              <outputDirectory>${project.build.directory}</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
